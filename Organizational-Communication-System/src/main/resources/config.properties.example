# Copy this file to "config.properties" in the project root (or set -Docs.config=/path/to/file)
# config.properties is git-ignored so credentials are never committed.

# --- Database ---
db.url=jdbc:mysql://localhost:3306/ocs?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=ocs_user
db.password=change_me

# --- Server ---
server.port=8080
# Set to true when the app is served over HTTPS (adds the Secure flag to the session cookie)
cookie.secure=false

# --- Security (SRS SC-5, SC-6; values were TBD items 12 and 13) ---
session.timeout.minutes=30
login.max.attempts=5

# --- First-run administrator (created only if no admin exists yet; SRS ID-2) ---
admin.name=Administrator
admin.username=admin
admin.password=ChangeMe123!
